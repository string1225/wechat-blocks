[Unit]
Description=WeChat Blocks progress API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wechat-blocks
Group=wechat-blocks
WorkingDirectory=/opt/wechat-blocks/current
EnvironmentFile=/etc/wechat-blocks/server.env
ExecStart=/usr/bin/python3 -u server/server.py
Restart=on-failure
RestartSec=3
StateDirectory=wechat-blocks
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wechat-blocks

[Install]
WantedBy=multi-user.target
